# apps/web/.env.local.example
#
# Copy to apps/web/.env.local and fill in your own values.
# See docs/SETUP.md for where each key comes from.

# API base URL — MUST stay empty. Next.js resolves /api against the current
# origin; setting this breaks the deployed build.
NEXT_PUBLIC_API_BASE_URL=

# Supabase — Project Settings > API Keys. Safe to expose: Row Level Security
# is what protects the data. See docs/DATABASE.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MapTiler — map tiles for MapLibre (web only). Client-visible, so restrict
# the key by domain in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=

# Server-side only — read in apps/web/src/app/api/*, never sent to the
# browser. Do NOT add a NEXT_PUBLIC_ prefix to these.
ORS_API_KEY=
GOOGLE_WEATHER_API_KEY=
