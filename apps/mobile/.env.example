# apps/mobile/.env.example
#
# Copy to apps/mobile/.env and fill in your own values.
# See docs/SETUP.md for where each key comes from.

# Supabase — the same project URL and publishable key as the web app.
# These are the only two variables the mobile app actually reads
# (packages/lib/supabase/client.native.ts).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Intended base URL for API requests — but currently IGNORED. The mobile
# route form hardcodes http://localhost:3000 instead:
#
#   apps/mobile/src/components/GenerateRouteForm/GenerateRouteForm.tsx:57
#
# The only reader of this variable is getApiBase(), which is called from
# fetchCombinedRouteData() — a web-only code path. Setting it has no effect
# until that is fixed; to run against a physical device or a different port,
# edit the hardcoded line. See docs/SETUP.md > Mobile.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# No ORS, Google Weather or MapTiler keys are needed here. Routing and
# weather go through the web app's API routes (which hold those keys
# server-side), and maps are native via react-native-maps.
